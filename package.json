{
  "name": "lamport-warden",
  "version": "0.1.0",
  "private": true,
  "description": "Lamport Warden browser extension: reads every Solana signature request before your wallet does, says in one sentence what it will do, and stops it when that is not what you meant.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "1.95.8",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
